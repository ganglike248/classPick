VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# 카카오 애드핏(https://adfit.kakao.com) 광고 단위 ID
# 대시보드에서 광고 단위를 만들면 발급됨 (예: DAN-xxxxxxxxxxxx). 비워두면 광고가 표시되지 않음.
# 같은 단위 ID를 여러 페이지에서 재사용하면 같은 세션에서 짧은 시간 안에 중복
# 요청된 걸로 보여 뒤에 요청한 쪽이 채워지지 않을 수 있다 — 페이지별로 단위를
# 따로 만드는 걸 권장.
# ANCHOR: 화면 하단에 고정되는 앵커 배너용 광고 단위 (단위 만들 때 형식을 "앵커 배너"로 선택)
# CONTENT: 결과 화면 본문에 들어가는 배너용 광고 단위 (권장 사이즈 728x90)
# RANKING: 랭킹 화면 본문에 들어가는 배너용 광고 단위 (비워두면 CONTENT 값을 재사용)
VITE_ADFIT_UNIT_ID_ANCHOR=
VITE_ADFIT_UNIT_ID_CONTENT=
VITE_ADFIT_UNIT_ID_RANKING=
